{
  "name": "ncedit7lab-extension",
  "publisher": "d-creations",
  "displayName": "NC-CODE7Lab",
  "description": "Custom Editor for CNC files like NC/MPF PA P1 P2 P3 M S and more, with integrated  workbench panel for CNC data visualization.",
  "version": "1.0.8",
  "repository": {
    "type": "git",
    "url": "https://github.com/d-creations/ncedit7lab-vsextension.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:ncedit7lab.editor",
    "onView:ncedit7lab.workbenchPanelView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "keybindings": [
      {
        "command": "ncedit7lab.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeCustomEditorId == 'ncedit7lab.editor'"
      },
      {
        "command": "ncedit7lab.replace",
        "key": "ctrl+h",
        "mac": "cmd+alt+f",
        "when": "activeCustomEditorId == 'ncedit7lab.editor'"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "ncedit7lab.find",
          "when": "activeCustomEditorId == 'ncedit7lab.editor'"
        },
        {
          "command": "ncedit7lab.replace",
          "when": "activeCustomEditorId == 'ncedit7lab.editor'"
        }
      ]
    },
    "commands": [
      {
        "command": "ncedit7lab.openWorkbenchPanel",
        "title": "ncedit7lab: Open Workbench Panel"
      },
      {
        "command": "ncedit7lab.find",
        "title": "Find"
      },
      {
        "command": "ncedit7lab.replace",
        "title": "Replace"
      }
    ],
    "customEditors": [
      {
        "viewType": "ncedit7lab.editor",
        "displayName": "ncedit7lab Editor",
        "selector": [
          {
            "filenamePattern": "*.mpf"
          },
          {
            "filenamePattern": "*.nc"
          },
          {
            "filenamePattern": "*.PA"
          },
          {
            "filenamePattern": "*.pa"
          },
          {
            "filenamePattern": "*.P1"
          },
          {
            "filenamePattern": "*.p1"
          },
          {
            "filenamePattern": "*.P2"
          },
          {
            "filenamePattern": "*.p2"
          },
          {
            "filenamePattern": "*.P3"
          },
          {
            "filenamePattern": "*.p3"
          },
          {
            "filenamePattern": "*.M"
          },
          {
            "filenamePattern": "*.m"
          },
          {
            "filenamePattern": "*.S"
          },
          {
            "filenamePattern": "*.s"
          },
          {
            "filenamePattern": "*p-2*"
          }
        ],
        "priority": "default",
        "diffEditorPriority": "option",
        "mergeEditorPriority": "option"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "ncedit7labBottomPanel",
          "title": "ncedit7lab",
          "icon": "$(tools)"
        }
      ]
    },
    "views": {
      "ncedit7labBottomPanel": [
        {
          "type": "webview",
          "id": "ncedit7lab.workbenchPanelView",
          "name": "ncedit7lab Workbench",
          "icon": "$(layout-panel)"
        }
      ]
    },
    "configuration": {
      "title": "ncedit7lab",
      "properties": {
        "ncedit7lab.backendBaseUrl": {
          "type": "string",
          "default": "",
          "description": "Optional absolute backend base URL override. Leave empty to use the embedded local backend."
        },
        "ncedit7lab.ptm.defaultIpAddress": {
          "type": "string",
          "default": "DEMO",
          "description": "Default IP Address to use for the PTM CNC connection."
        },
        "ncedit7lab.theme.mode": {
          "type": "string",
          "enum": [
            "vscode",
            "one-dark",
            "light"
          ],
          "default": "vscode",
          "description": "Theme mode used inside ncedit7lab webviews."
        },
        "ncedit7lab.layout.ptmPlacement": {
          "type": "string",
          "enum": [
            "side-panel",
            "bottom-panel",
            "external-panel",
            "disabled"
          ],
          "default": "external-panel",
          "description": "Where PTM should appear inside the VS Code custom editor host."
        },
        "ncedit7lab.showDrawPanel": {
          "type": "boolean",
          "default": true,
          "description": "Show the Draw panel in ncedit7lab."
        },
        "ncedit7lab.transferProtocol": {
          "type": "string",
          "enum": [
            "none",
            "focas",
            "ftp"
          ],
          "default": "none",
          "description": "Which protocol to use for CNC file transfer features in ncedit7lab. 'focas' uses the FOCAS library to transfer files directly to the CNC machine, while 'ftp' uses FTP protocol for file transfer. 'none' disables the transfer features."
        },
        "ncedit7lab.transferDriverPath": {
          "type": "string",
          "default": "C:\\Drivers\\ncedit7",
          "description": "Path to the transfer driver."
        },
        "ncedit7lab.showPtmTransfer": {
          "type": "boolean",
          "default": false,
          "description": "Show the Ptm Transfer in ncedit7lab."
        },
        "ncedit7lab.templatesPlacement": {
          "type": "string",
          "enum": [
            "workbench-left",
            "workbench-right",
            "disabled"
          ],
          "default": "disabled",
          "description": "Where the Templates manager is hosted in VS Code."
        },
        "ncedit7lab.toolsPlacement": {
          "type": "string",
          "enum": [
            "workbench-left",
            "workbench-right",
            "disabled"
          ],
          "default": "workbench-right",
          "description": "Where the Tools manager is hosted in VS Code."
        },
        "ncedit7lab.simulation.gpuDefaultEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable GPU-accelerated material removal simulation by default."
        },
        "ncedit7lab.simulation.gpuPitchMm.min": {
          "type": "number",
          "default": 0.001,
          "description": "Minimum allowed GPU pitch resolution in millimeters."
        },
        "ncedit7lab.simulation.gpuPitchMm.max": {
          "type": "number",
          "default": 5,
          "description": "Maximum allowed GPU pitch resolution in millimeters."
        },
        "ncedit7lab.simulation.gpuPitchMm.default": {
          "type": "number",
          "default": 0.02,
          "description": "Default GPU pitch resolution in millimeters."
        },
        "ncedit7lab.simulation.cpuResolutionMm.min": {
          "type": "number",
          "default": 0.05,
          "description": "Minimum allowed CPU material removal resolution in millimeters."
        },
        "ncedit7lab.simulation.cpuResolutionMm.max": {
          "type": "number",
          "default": 5,
          "description": "Maximum allowed CPU material removal resolution in millimeters."
        },
        "ncedit7lab.simulation.cpuResolutionMm.default": {
          "type": "number",
          "default": 0.05,
          "description": "Default CPU material removal resolution in millimeters."
        },
        "ncedit7lab.simulation.stockMemoryMiB": {
          "type": "number",
          "default": 256,
          "description": "Maximum memory budget in MiB allocated for stock simulation."
        },
        "ncedit7lab.simulation.gpuStockPixelBudget.min": {
          "type": "number",
          "default": 250000,
          "description": "Minimum GPU stock pixel budget."
        },
        "ncedit7lab.simulation.gpuStockPixelBudget.max": {
          "type": "number",
          "default": 1500000,
          "description": "Maximum GPU stock pixel budget."
        },
        "ncedit7lab.simulation.gpuStockPixelBudget.default": {
          "type": "number",
          "default": 800000,
          "description": "Default GPU stock pixel budget."
        },
        "ncedit7lab.simulation.gpuStockPixelBudget.nativeSharpness": {
          "type": "boolean",
          "default": false,
          "description": "Use native display sharpness for GPU stock rendering."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run bundle",
    "compile": "npx tsc -p ./",
    "watch": "npx tsc -watch -p ./",
    "prepare": "npm run compile",
    "setup:python": "node ./scripts/download-python.js",
    "generate:licenses": "node ./scripts/generate-licenses.js",
    "bundle": "npm run setup:python && npm run generate:licenses && node ./scripts/bundle.js",
    "package": "npx @vscode/vsce package",
    "package:publish": "node ./scripts/publish.js"
  },
  "dependencies": {
    "ncedit7lab": "git+https://github.com/d-creations/ncedit7lab.git"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^3.9.1",
    "license-checker": "^25.0.1",
    "typescript": "^5.0.4"
  }
}